DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
# Discord Premium Apps User Subscription SKU (assignable to one server)
DISCORD_PREMIUM_SKU_ID=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
SESSION_SECRET=replace-with-a-long-random-string
PORT=3000
DATABASE_PATH=./data/crazyland.db

# Recurring PayPal premium (create an active regular billing plan in PayPal)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# Creator Alerts provider credentials
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Initial refresh tokens from creators who grant video.list, keyed by lowercase handle.
TIKTOK_CREATOR_REFRESH_TOKENS={}
